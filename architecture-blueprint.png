/WyzG9e--><!--cqw1tb MnlGHc_el/WyzG9e--></div></div><!--TgQPHd|||[{&quot;u&quot;:0}]--></div><div jsuid="MnlGHc_es" jsname="vbNNGf" class="qIQse LGoVQ" style="display: none;" jsaction="mouseenter:&amp;MnlGHc_es|ZUljYd;mouseleave:&amp;MnlGHc_es|aXD3Gb;rcuQ6b:&amp;MnlGHc_es|npT2md" jscontroller="i6HcHb#c0e67c" data-sfc-root="c" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Q_vwSeggIAggBCBUQEA" data-hveid="CAIIAQgVEBA" data-processed="true" data-sfc-inited="2"><!--qkimaf MnlGHc_es/HugV6--><!--cqw1tb MnlGHc_es/HugV6--><!--TgQPHd|||[]--></div><div jsaction="rcuQ6b:&amp;MnlGHc_f0|npT2md" jscontroller="CAwPlc#Hx4Oqd" data-sfc-root="c" jsuid="MnlGHc_f0" data-wiz-uids="MnlGHc_f1,MnlGHc_f2" data-processed="true" data-sfc-inited="2"><div jsuid="MnlGHc_f1" class="qacuz Haco6c RVppL" role="alert" aria-live="assertive" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Q-LISeggIAggBCBUQEQ" data-processed="true"><div class="YsAfEc" data-processed="true"><span class="lObrHb RVppL" data-processed="true"><div jsaction="" jscontroller="sRLmTc#WhfBh" data-sfc-root="c" jsuid="MnlGHc_fb" data-processed="true"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#5e5e5e"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z" fill="currentColor"></path></svg><!--TgQPHd|||[]--></div></span><span tabindex="-1" class="zg2IJb" data-processed="true"></span></div><button jsuid="MnlGHc_f2" type="button" class="jqVAid RVppL" jsaction="click:&amp;MnlGHc_f0|ZUljYd" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Qm_ASeggIAggBCBUQEg" data-hveid="CAIIAQgVEBI" data-processed="true"></button><button class="oZOOsc RVppL" aria-label="Close" jsaction="click:&amp;MnlGHc_f0|Mrjwi" data-processed="true"><svg aria-hidden="true" class="EQxvpc A9rHGd" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" jsaction="" jscontroller="zOvrRc#mVUp1c" data-sfc-root="ep" jsuid="MnlGHc_fz"><path d="M256-200l-56-56L424-480L200-704l56-56L480-536L704-760l56,56L536-480L760-256l-56,56L480-424L256-200Z"></path><!--TgQPHd|||[]--></svg></button></div><!--TgQPHdMnlGHc_b8/YOIIaf;MnlGHc_b8/VWapad|||[{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_b8/YOIIaf&quot;},{&quot;s&quot;:null,&quot;i&quot;:&quot;MnlGHc_b8/VWapad&quot;},156,{&quot;s&quot;:null,&quot;i&quot;:&quot;MnlGHc_b8/C5DOxd&quot;},[&quot;AimExportActionToastLink&quot;,309275],&quot;\u0026MnlGHc_b8:bREfu&quot;,false]--></div><!--TgQPHd|MnlGHc_b8/LL5gb;MnlGHc_b8/YOIIaf;MnlGHc_b8/We76zc;MnlGHc_b8/C5DOxd;MnlGHc_b8/VWapad||[[null,0,null,0,null,0,[&quot;77\n 78\n 79\n 80\n 81\n 82\n 83\n 84\n 85\n 86\n 87\n 88\n 89\n 90\n 91\n 92\n 93\n 94\n 95\n 96\n 97\n 98\n 99\n100\n101\n102\n103\n104\n105\n106\n107\n108\n109\n110\n111\n112\n113\n114\n115\n116\n117\n118\n119\n120\n121\n122\n123\n124\n125\n126\n127\n128\n129\n130\n131\n132\n133\n134\n135\n136\n137\n138\n139\n140\n141\n142\n143\n144\n145\n146\n147\n148\n149\n150\n151\n152\n153\n154\n155\n156\n157\n158\n159\n160\n161\n162\n163\n164\n\u003c!DOCTYPE html\u003e\n        .btn:hover {\n            background-color: #30363d;\n            border-color: #8b949e;\n        }\n        footer {\n            text-align: center;\n            padding: 2rem;\n            border-top: 1px solid var(--border-color);\n            font-size: 0.9rem;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader\u003e\n        \u003ch1\u003eKofi Agyei\u003c/h1\u003e\n        \u003cp\u003eCybersecurity Analyst \u0026 Systems Security Engineer\u003c/p\u003e\n    \u003c/header\u003e\n\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n        \n        \u003c!-- Skills Section --\u003e\n        \u003csection\u003e\n            \u003ch2\u003e🛠️ Technical Security Skills \u0026 Tools\u003c/h2\u003e\n            \u003cul class\u003d\&quot;skills-list\&quot;\u003e\n                \u003cli\u003e🟢 Network Scanning: \u003cstrong\u003eNmap\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Exploitation: \u003cstrong\u003eMetasploit\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Traffic Analysis: \u003cstrong\u003eWireshark\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 SIEM \u0026 Analytics: \u003cstrong\u003eSplunk\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Boundary Routing: \u003cstrong\u003epfSense / VPN\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Testing: \u003cstrong\u003eBlack Box Testing\u003c/strong\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n        \u003c/section\u003e\n\n        \u003chr style\u003d\&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;\&quot;\u003e\n\n        \u003c!-- Projects Section --\u003e\n        \u003ch2\u003e🚀 Cyber Range Portfolio Projects\u003c/h2\u003e\n\n        \u003c!-- Project 1 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 1: Black Box Hacking Simulation (Capstone)\u003c/h3\u003e\n            \u003cp\u003eSimulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eReconnaissance \u0026 Scanning:\u003c/strong\u003e Used Nmap for passive asset mapping and service fingerprinting.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003ePacket Analysis:\u003c/strong\u003e Tracked communication layers using Wireshark to locate system vulnerabilities.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eExploitation Sequence:\u003c/strong\u003e Used Metasploit Framework vectors to achieve root authorization footprints.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;black-box-hacking.png\&quot; alt\u003d\&quot;Black Box Hacking Lab Screen\&quot;\u003e\n            \u003ca href\u003d\&quot;./Presentation1Black%20Box%20system%20testing.pptx\&quot; class\u003d\&quot;btn\&quot;\u003e📂 Download Presentation\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Project 2 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 2: Enterprise Hybrid Lab \u0026 Splunk SIEM Engineering\u003c/h3\u003e\n            \u003cp\u003eDesigned a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eNetwork Isolation:\u003c/strong\u003e Programmed pfSense firewalls to contain lateral host movement.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eOffensive Auditing:\u003c/strong\u003e Ran custom vulnerability sequences against target systems and corporate web elements.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eDetection Engineering:\u003c/strong\u003e Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;network-topology.png\&quot; alt\u003d\&quot;EVE-NG Network Topology Map\&quot;\u003e\n            \u003ca href\u003d\&quot;./defensive-blue-team/splunk/\&quot; class\u003d\&quot;btn\&quot;\u003e💻 View Splunk Configurations\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Contact Section --\u003e\n        \u003csection style\u003d\&quot;text-align: center; margin-top: 4rem;\&quot;\u003e\n            \u003ch2\u003e📩 Connect With Me\u003c/h2\u003e\n            \u003cp\u003eLooking for a dedicated Security Analyst? Let&#39;s talk!\u003c/p\u003e\n            \u003cp\u003e\u003cstrong\u003eEmail:\u003c/strong\u003e kofiagyei79@gmail.com\u003c/p\u003e\n            \u003ca href\u003d\&quot;https://github.com\&quot; class\u003d\&quot;btn\&quot;\u003eGitHub Profile\u003c/a\u003e\n        \u003c/section\u003e\n\n    \u003c/div\u003e\n\n    \u003cfooter\u003e\n        \u0026copy; 2026 Kofi Agyei Portfolio. Built with HTML5 \u0026 CSS3.\n    \u003c/footer\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n\nUse Control + Shift + m to toggle the tab key moving focus. Alternatively, use esc then tab to move to the next interactive element on the page.&quot;],1,0,[&quot;77\n 78\n 79\n 80\n 81\n 82\n 83\n 84\n 85\n 86\n 87\n 88\n 89\n 90\n 91\n 92\n 93\n 94\n 95\n 96\n 97\n 98\n 99\n100\n101\n102\n103\n104\n105\n106\n107\n108\n109\n110\n111\n112\n113\n114\n115\n116\n117\n118\n119\n120\n121\n122\n123\n124\n125\n126\n127\n128\n129\n130\n131\n132\n133\n134\n135\n136\n137\n138\n139\n140\n141\n142\n143\n144\n145\n146\n147\n148\n149\n150\n151\n152\n153\n154\n155\n156\n157\n158\n159\n160\n161\n162\n163\n164\n\u003c!DOCTYPE html\u003e\n        .btn:hover {\n            background-color: #30363d;\n            border-color: #8b949e;\n        }\n        footer {\n            text-align: center;\n            padding: 2rem;\n            border-top: 1px solid var(--border-color);\n            font-size: 0.9rem;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader\u003e\n        \u003ch1\u003eKofi Agyei\u003c/h1\u003e\n        \u003cp\u003eCybersecurity Analyst \u0026 Systems Security Engineer\u003c/p\u003e\n    \u003c/header\u003e\n\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n        \n        \u003c!-- Skills Section --\u003e\n        \u003csection\u003e\n            \u003ch2\u003e🛠️ Technical Security Skills \u0026 Tools\u003c/h2\u003e\n            \u003cul class\u003d\&quot;skills-list\&quot;\u003e\n                \u003cli\u003e🟢 Network Scanning: \u003cstrong\u003eNmap\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Exploitation: \u003cstrong\u003eMetasploit\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Traffic Analysis: \u003cstrong\u003eWireshark\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 SIEM \u0026 Analytics: \u003cstrong\u003eSplunk\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Boundary Routing: \u003cstrong\u003epfSense / VPN\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Testing: \u003cstrong\u003eBlack Box Testing\u003c/strong\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n        \u003c/section\u003e\n\n        \u003chr style\u003d\&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;\&quot;\u003e\n\n        \u003c!-- Projects Section --\u003e\n        \u003ch2\u003e🚀 Cyber Range Portfolio Projects\u003c/h2\u003e\n\n        \u003c!-- Project 1 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 1: Black Box Hacking Simulation (Capstone)\u003c/h3\u003e\n            \u003cp\u003eSimulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eReconnaissance \u0026 Scanning:\u003c/strong\u003e Used Nmap for passive asset mapping and service fingerprinting.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003ePacket Analysis:\u003c/strong\u003e Tracked communication layers using Wireshark to locate system vulnerabilities.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eExploitation Sequence:\u003c/strong\u003e Used Metasploit Framework vectors to achieve root authorization footprints.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;black-box-hacking.png\&quot; alt\u003d\&quot;Black Box Hacking Lab Screen\&quot;\u003e\n            \u003ca href\u003d\&quot;./Presentation1Black%20Box%20system%20testing.pptx\&quot; class\u003d\&quot;btn\&quot;\u003e📂 Download Presentation\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Project 2 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 2: Enterprise Hybrid Lab \u0026 Splunk SIEM Engineering\u003c/h3\u003e\n            \u003cp\u003eDesigned a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eNetwork Isolation:\u003c/strong\u003e Programmed pfSense firewalls to contain lateral host movement.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eOffensive Auditing:\u003c/strong\u003e Ran custom vulnerability sequences against target systems and corporate web elements.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eDetection Engineering:\u003c/strong\u003e Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;network-topology.png\&quot; alt\u003d\&quot;EVE-NG Network Topology Map\&quot;\u003e\n            \u003ca href\u003d\&quot;./defensive-blue-team/splunk/\&quot; class\u003d\&quot;btn\&quot;\u003e💻 View Splunk Configurations\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Contact Section --\u003e\n        \u003csection style\u003d\&quot;text-align: center; margin-top: 4rem;\&quot;\u003e\n            \u003ch2\u003e📩 Connect With Me\u003c/h2\u003e\n            \u003cp\u003eLooking for a dedicated Security Analyst? Let&#39;s talk!\u003c/p\u003e\n            \u003cp\u003e\u003cstrong\u003eEmail:\u003c/strong\u003e kofiagyei79@gmail.com\u003c/p\u003e\n            \u003ca href\u003d\&quot;https://github.com\&quot; class\u003d\&quot;btn\&quot;\u003eGitHub Profile\u003c/a\u003e\n        \u003c/section\u003e\n\n    \u003c/div\u003e\n\n    \u003cfooter\u003e\n        \u0026copy; 2026 Kofi Agyei Portfolio. Built with HTML5 \u0026 CSS3.\n    \u003c/footer\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n\nUse Control + Shift + m to toggle the tab key moving focus. Alternatively, use esc then tab to move to the next interactive element on the page.&quot;,&quot;1 tab&quot;]]]--></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-