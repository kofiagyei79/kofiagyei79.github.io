 jsuid="MnlGHc_jg" data-sfc-cp="" jsaction="" jscontroller="cXTEid#e0nEwf" data-sfc-root="ep" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Qh9gSeggIAggBCC0QCQ" data-processed="true"><button jsuid="MnlGHc_jn" class="FTsWP RmjGdc IsqrXb thAwWe" id="" aria-label="Edit &lt;!DOCTYPE html&gt;&lt;html lang=&quot;en&quot;&gt;&lt;head&gt; &lt;meta charset=&quot;UTF-8&quot;&gt; &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2.5rem; } .project-image { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--border-color); margin: 1.5rem 0; display: block; } .btn { display: inline-block; background-color: #21262d; color: var(--accent-color); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-right: 0.5rem; margin-top: 0.5rem; } .btn:hover { background-color: #30363d; border-color: #8b949e; } footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; } &lt;/style&gt;&lt;/head&gt;&lt;body&gt; &lt;header&gt; &lt;h1&gt;Kofi Agyei&lt;/h1&gt; &lt;p&gt;Cybersecurity Analyst &amp; Systems Security Engineer&lt;/p&gt; &lt;/header&gt; &lt;div class=&quot;container&quot;&gt; &lt;!-- Skills Section --&gt; &lt;section&gt; &lt;h2&gt;🛠️ Technical Security Skills &amp; Tools&lt;/h2&gt; &lt;ul class=&quot;skills-list&quot;&gt; &lt;li&gt;🟢 Network Scanning: &lt;strong&gt;Nmap&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Exploitation: &lt;strong&gt;Metasploit&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Traffic Analysis: &lt;strong&gt;Wireshark&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 SIEM &amp; Analytics: &lt;strong&gt;Splunk&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Boundary Routing: &lt;strong&gt;pfSense / VPN&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Testing: &lt;strong&gt;Black Box Testing&lt;/strong&gt;&lt;/li&gt; &lt;/ul&gt; &lt;/section&gt; &lt;hr style=&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;&quot;&gt; &lt;!-- Projects Section --&gt; &lt;h2&gt;🚀 Cyber Range Portfolio Projects&lt;/h2&gt; &lt;!-- Project 1 --&gt; &lt;div class=&quot;project-card&quot;&gt; &lt;h3&gt;Project 1: Black Box Hacking Simulation (Capstone)&lt;/h3&gt; &lt;p&gt;Simulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Reconnaissance &amp; Scanning:&lt;/strong&gt; Used Nmap for passive asset mapping and service fingerprinting.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Packet Analysis:&lt;/strong&gt; Tracked communication layers using Wireshark to locate system vulnerabilities.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Exploitation Sequence:&lt;/strong&gt; Used Metasploit Framework vectors to achieve root authorization footprints.&lt;/li&gt; &lt;/ul&gt; &lt;img class=&quot;project-image&quot; src=&quot;black-box-hacking.png&quot; alt=&quot;Black Box Hacking Lab Screen&quot;&gt; &lt;a href=&quot;./Presentation1Black%20Box%20system%20testing.pptx&quot; class=&quot;btn&quot;&gt;📂 Download Presentation&lt;/a&gt; &lt;/div&gt; &lt;!-- Project 2 --&gt; &lt;div class=&quot;project-card&quot;&gt; &lt;h3&gt;Project 2: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/h3&gt; &lt;p&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Network Isolation:&lt;/strong&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Offensive Auditing:&lt;/strong&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Detection Engineering:&lt;/strong&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/li&gt; &lt;/ul&gt; &lt;img class=&quot;project-image&quot; src=&quot;network-topology.png&quot; alt=&quot;EVE-NG Network Topology Map&quot;&gt; &lt;a href=&quot;./defensive-blue-team/splunk/&quot; class=&quot;btn&quot;&gt;💻 View Splunk Configurations&lt;/a&gt; &lt;/div&gt; &lt;!-- Contact Section --&gt; &lt;section style=&quot;text-align: center; margin-top: 4rem;&quot;&gt; &lt;h2&gt;📩 Connect With Me&lt;/h2&gt; &lt;p&gt;Looking for a dedicated Security Analyst? Let&#39;s talk!&lt;/p&gt; &lt;p&gt;&lt;strong&gt;Email:&lt;/strong&gt; kofiagyei79@gmail.com&lt;/p&gt; &lt;a href=&quot;https://github.com&quot; class=&quot;btn&quot;&gt;GitHub Profile&lt;/a&gt; &lt;/section&gt; &lt;/div&gt; &lt;footer&gt; &amp;copy; 2026 Kofi Agyei Portfolio. Built with HTML5 &amp; CSS3. &lt;/footer&gt;&lt;/body&gt;&lt;/html&gt;" data-tooltip-classes="undefined" data-is-tooltip-wrapper="undefined" data-tooltip-id="undefined" aria-describedby="" data-sfc-cp="" jsaction="pointerdown:&amp;MnlGHc_jn|FEiYhc;pointerup:&amp;MnlGHc_jn|mF5Elf;pointerenter:&amp;MnlGHc_jn|EX0mI;pointerleave:&amp;MnlGHc_jn|vpvbp;pointercancel:&amp;MnlGHc_jn|xyn4sd;contextmenu:&amp;MnlGHc_jn|i2ZJ6;click:&amp;MnlGHc_jn|h5M12e;focus:&amp;MnlGHc_jn|h06R8;blur:&amp;MnlGHc_jn|zjh6rb;" data-wiz-attrbind="disabled=MnlGHc_jn/ggNWmb" jscontroller="h6yBLd#FVMj3d" data-sfc-root="c" data-processed="true"><span class="XjoK4b kkxvEb" jsaction="" jscontroller="bJ5zY#LlrZ1b" data-sfc-root="c" jsuid="MnlGHc_m9" data-processed="true"><!--TgQPHd|||[]--></span><span jsuid="MnlGHc_md" class="UTNHae" jsaction="QBlI0e:&amp;MnlGHc_md|JwG8nd;BTifte:&amp;MnlGHc_md|ie0cXb;nqgE9d:&amp;MnlGHc_md|LZznfb;fHTtBd:&amp;MnlGHc_md|i8hBpd;" data-wiz-attrbind="class=MnlGHc_md/ggNWmb" jscontroller="MAxPne#DBBRWd" data-sfc-root="c" data-processed="true"><!--TgQPHd|||[{&quot;u&quot;:0},false]--></span><span class="I36Cje" aria-hidden="true" data-processed="true"><svg fill="currentColor" width="24px" height="24px" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M200-200h50.46l409.46-409.46-50.46-50.46L200-250.46V-200Zm-60 60v-135.38l527.62-527.39q9.07-8.24 20.03-12.73 10.97-4.5 23-4.5t23.3 4.27q11.28 4.27 19.97 13.58l48.85 49.46q9.31 8.69 13.27 20 3.96 11.31 3.96 22.62 0 12.07-4.12 23.03-4.12 10.97-13.11 20.04L275.38-140H140Zm620.38-570.15-50.23-50.23 50.23 50.23Zm-126.13 75.9-24.79-25.67 50.46 50.46-25.67-24.79Z"></path></svg></span><div class="ypuoue" data-processed="true"></div><!--TgQPHd|||[false,{&quot;u&quot;:0},&quot;\u0026MnlGHc_jg:UEmoBd&quot;,{&quot;u&quot;:0}]--></button><!--TgQPHd||GVEHxc=*Q0pj3b|[]--></div><div jsuid="MnlGHc_j7" data-xid="" class="tHaXU eksFZe LxDObf" tabindex="-1" aria-hidden="false" jsaction="mouseenter:&amp;MnlGHc_j3|wndyDd;mouseleave:&amp;MnlGHc_j3|yrMC6" data-wiz-attrbind="class=MnlGHc_j3/URFwmf" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4QlK0UeggIAggBCC0QCg" data-processed="true"><div jsuid="MnlGHc_ja" class="LGKDTe BQmez" aria-hidden="true" data-processed="true"><div jsuid="MnlGHc_jb" class="Xg7lfd" data-processed="true"></div><div class="xYn6Gf" data-processed="true">Edit</div></div></div><!--TgQPHd|||[[3,2],&quot;LxDObf&quot;,false,false,false,{&quot;u&quot;:0},{&quot;u&quot;:0},{&quot;u&quot;:0}]--></div></div><!--TgQPHdMnlGHc_c3/CiuJBb;MnlGHc_c3/rssjMe;MnlGHc_c3/ypKQA;MnlGHc_c3/TBFcKe|MnlGHc_eq/gLtYT||[{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_c3/CiuJBb&quot;},{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_c3/TBFcKe&quot;},{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_c3/rssjMe&quot;},{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_c3/ypKQA&quot;},&quot;\u0026MnlGHc_c3:AkmJwe&quot;,&quot;\u0026MnlGHc_c3:XqjZT&quot;,&quot;\u0026MnlGHc_c3:l7J6xb&quot;]--></div><!--cqw1tb MnlGHc_c3/WyzG9e--><div class="tbIZh wQN2Jd Odbbif sg3dY" jsuid="MnlGHc_ck" data-processed="true"><div class="AdmSkc" data-processed="true"><div jsuid="MnlGHc_cw" data-processed="true"><div jsaction="" jscontroller="oftuzd#gEQife" data-sfc-root="c" jsuid="MnlGHc_nn" data-processed="true"><div class="" data-processed="true"><div class="HAzzKb awETSc ZHtB2c" data-processed="true"><img class="iQLZR" src="./architecture-blueprint_files/favicon-tbn" alt="" data-imglogged="true" data-aatf="4" data-processed="true"><span class="uCTG2e" data-processed="true"><span class="PQHXJe VndcI" data-processed="true">GitHub · Change is constant. GitHub keeps you ahead. · GitHub</span></span></div></div><!--TgQPHd|||[]--></div></div><!--qkimaf MnlGHc_c3/lC1IR--><!--cqw1tb MnlGHc_c3/lC1IR--><!--qkimaf MnlGHc_c3/Y6wv1e--><div jsuid="MnlGHc_cl" class="sUKAcb" data-processed="true"><span jsuid="MnlGHc_cj" class="VndcI veK2kb" jsname="eFVkfb" tabindex="-1" data-processed="true"><span jsname="y5v2y" data-processed="true">&lt;!DOCTYPE html&gt;&lt;html lang="en"&gt;&lt;head&gt; &lt;meta charset="UTF-8"&gt; &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2.5rem; } .project-image { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--border-color); margin: 1.5rem 0; display: block; } .btn { display: inline-block; background-color: #21262d; color: var(--accent-color); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-right: 0.5rem; margin-top: 0.5rem; } .btn:hover { background-color: #30363d; border-color: #8b949e; } footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; } &lt;/style&gt;&lt;/head&gt;&lt;body&gt; &lt;header&gt; &lt;h1&gt;Kofi Agyei&lt;/h1&gt; &lt;p&gt;Cybersecurity Analyst &amp; Systems Security Engineer&lt;/p&gt; &lt;/header&gt; &lt;div class="container"&gt; &lt;!-- Skills Section --&gt; &lt;section&gt; &lt;h2&gt;🛠️ Technical Security Skills &amp; Tools&lt;/h2&gt; &lt;ul class="skills-list"&gt; &lt;li&gt;🟢 Network Scanning: &lt;strong&gt;Nmap&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Exploitation: &lt;strong&gt;Metasploit&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Traffic Analysis: &lt;strong&gt;Wireshark&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 SIEM &amp; Analytics: &lt;strong&gt;Splunk&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Boundary Routing: &lt;strong&gt;pfSense / VPN&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Testing: &lt;strong&gt;Black Box Testing&lt;/strong&gt;&lt;/li&gt; &lt;/ul&gt; &lt;/section&gt; &lt;hr style="border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;"&gt; &lt;!-- Projects Section --&gt; &lt;h2&gt;🚀 Cyber Range Portfolio Projects&lt;/h2&gt; &lt;!-- Project 1 --&gt; &lt;div class="project-card"&gt; &lt;h3&gt;Project 1: Black Box Hacking Simulation (Capstone)&lt;/h3&gt; &lt;p&gt;Simulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Reconnaissance &amp; Scanning:&lt;/strong&gt; Used Nmap for passive asset mapping and service fingerprinting.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Packet Analysis:&lt;/strong&gt; Tracked communication layers using Wireshark to locate system vulnerabilities.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Exploitation Sequence:&lt;/strong&gt; Used Metasploit Framework vectors to achieve root authorization footprints.&lt;/li&gt; &lt;/ul&gt; &lt;img class="project-image" src="black-box-hacking.png" alt="Black Box Hacking Lab Screen"&gt; &lt;a href="./Presentation1Black%20Box%20system%20testing.pptx" class="btn"&gt;📂 Download Presentation&lt;/a&gt; &lt;/div&gt; &lt;!-- Project 2 --&gt; &lt;div class="project-card"&gt; &lt;h3&gt;Project 2: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/h3&gt; &lt;p&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Network Isolation:&lt;/strong&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Offensive Auditing:&lt;/strong&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Detection Engineering:&lt;/strong&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/li&gt; &lt;/ul&gt; &lt;img class="project-image" src="network-topology.png" alt="EVE-NG Network Topology Map"&gt; &lt;a href="./defensive-blue-team/splunk/" class="btn"&gt;💻 View Splunk Configurations&lt;/a&gt; &lt;/div&gt; &lt;!-- Contact Section --&gt; &lt;section style="text-align: center; margin-top: 4rem;"&gt; &lt;h2&gt;📩 Connect With Me&lt;/h2&gt; &lt;p&gt;Looking for a dedicated Security Analyst? Let's talk!&lt;/p&gt; &lt;p&gt;&lt;strong&gt;Email:&lt;/strong&gt; kofiagyei79@gmail.com&lt;/p&gt; &lt;a href="https://github.com" class="btn"&gt;GitHub Profile&lt;/a&gt; &lt;/section&gt; &lt;/div&gt; &lt;footer&gt; &amp;copy; 2026 Kofi Agyei Portfolio. Built with HTML5 &amp; CSS3. &lt;/footer&gt;&lt;/body&gt;&lt;/html&gt;</span></span><div role="button" class="l1LGWd" aria-expanded="false" tabindex="0" style="display: flex;" aria-label="Query Preview for GitHub · Change is constant. GitHub keeps you ahead. · GitHub" jsaction="click:&amp;MnlGHc_c3|yrMC6;touchstart:&amp;MnlGHc_c3|w9rIQb;touchend:&amp;MnlGHc_c3|SAMwlb;touchmove:&amp;MnlGHc_c3|hQOfOb;touchcancel:&amp;MnlGHc_c3|B68ZWe" data-processed="true"><div class="eacPZd" jsaction="" jscontroller="sRLmTc#WhfBh" data-sfc-root="c" jsuid="MnlGHc_oo" data-processed="true"><svg xmlns="http://www.w3.org/2000/svg" height="14px" viewBox="0 0 12 7" width="14px" fill="none"><path d="M6.00046 0.166733C5.88929 0.166733 5.78654 0.184733 5.69221 0.220733C5.59771 0.256899 5.50604 0.3194 5.41721 0.408234L0.583711 5.24173C0.422711 5.40273 0.340795 5.59573 0.337962 5.82073C0.335128 6.04573 0.417045 6.24157 0.583711 6.40823C0.744878 6.5694 0.939379 6.64998 1.16721 6.64998C1.39488 6.64998 1.5893 6.5694 1.75046 6.40823L6.00046 2.16673L10.2505 6.40823C10.4116 6.5694 10.6047 6.6514 10.8297 6.65423C11.0547 6.6569 11.2505 6.5749 11.4172 6.40823C11.5782 6.24723 11.6587 6.05282 11.6587 5.82498C11.6587 5.59715 11.5782 5.40273 11.4172 5.24173L6.58371 0.408234C6.49488 0.3194 6.40321 0.256899 6.30871 0.220733C6.21438 0.184733 6.11163 0.166733 6.00046 0.166733Z" fill="currentColor"></path></svg><!--TgQPHd|||[]--></div></div></div><!--cqw1tb MnlGHc_c3/Y6wv1e--></div></div></div><!--qkimaf MnlGHc_c3/nkGDxf--><!--cqw1tb MnlGHc_c3/nkGDxf--><div jsuid="MnlGHc_cu" class="UYpEO" style="" data-processed="true"><div class="kwdzO" data-processed="true">12:27 PM</div></div><div class="dcCF7d" data-processed="true"></div></div><!--TgQPHd|MnlGHc_c3/CiuJBb;MnlGHc_c3/rssjMe;MnlGHc_c3/ypKQA;MnlGHc_c3/TBFcKe||[[&quot;\u003c!DOCTYPE html\u003e\u003chtml lang\u003d\&quot;en\&quot;\u003e\u003chead\u003e \u003cmeta charset\u003d\&quot;UTF-8\&quot;\u003e \u003cmeta name\u003d\&quot;viewport\&quot; content\u003d\&quot;width\u003ddevice-width, initial-scale\u003d1.0\&quot;\u003e \u003ctitle\u003eKofi Agyei | Cybersecurity Portfolio\u003c/title\u003e \u003cstyle\u003e :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, \&quot;Segoe UI\&quot;, Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2.5rem; } .project-image { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--border-color); margin: 1.5rem 0; display: block; } .btn { display: inline-block; background-color: #21262d; color: var(--accent-color); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-right: 0.5rem; margin-top: 0.5rem; } .btn:hover { background-color: #30363d; border-color: #8b949e; } footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; } \u003c/style\u003e\u003c/head\u003e\u003cbody\u003e \u003cheader\u003e \u003ch1\u003eKofi Agyei\u003c/h1\u003e \u003cp\u003eCybersecurity Analyst \u0026 Systems Security Engineer\u003c/p\u003e \u003c/header\u003e \u003cdiv class\u003d\&quot;container\&quot;\u003e \u003c!-- Skills Section --\u003e \u003csection\u003e \u003ch2\u003e🛠️ Technical Security Skills \u0026 Tools\u003c/h2\u003e \u003cul class\u003d\&quot;skills-list\&quot;\u003e \u003cli\u003e🟢 Network Scanning: \u003cstrong\u003eNmap\u003c/strong\u003e\u003c/li\u003e \u003cli\u003e🟢 Exploitation: \u003cstrong\u003eMetasploit\u003c/strong\u003e\u003c/li\u003e \u003cli\u003e🟢 Traffic Analysis: \u003cstrong\u003eWireshark\u003c/strong\u003e\u003c/li\u003e \u003cli\u003e🟢 SIEM \u0026 Analytics: \u003cstrong\u003eSplunk\u003c/strong\u003e\u003c/li\u003e \u003cli\u003e🟢 Boundary Routing: \u003cstrong\u003epfSense / VPN\u003c/strong\u003e\u003c/li\u003e \u003cli\u003e🟢 Testing: \u003cstrong\u003eBlack Box Testing\u003c/strong\u003e\u003c/li\u003e \u003c/ul\u003e \u003c/section\u003e \u003chr style\u003d\&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;\&quot;\u003e \u003c!-- Projects Section --\u003e \u003ch2\u003e🚀 Cyber Range Portfolio Projects\u003c/h2\u003e \u003c!-- Project 1 --\u003e \u003cdiv class\u003d\&quot;project-card\&quot;\u003e \u003ch3\u003eProject 1: Black Box Hacking Simulation (Capstone)\u003c/h3\u003e \u003cp\u003eSimulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.\u003c/p\u003e \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e \u003cul\u003e \u003cli\u003e\u003cstrong\u003eReconnaissance \u0026 Scanning:\u003c/strong\u003e Used Nmap for passive asset mapping and service fingerprinting.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003ePacket Analysis:\u003c/strong\u003e Tracked communication layers using Wireshark to locate system vulnerabilities.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eExploitation Sequence:\u003c/strong\u003e Used Metasploit Framework vectors to achieve root authorization footprints.\u003c/li\u003e \u003c/ul\u003e \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;black-box-hacking.png\&quot; alt\u003d\&quot;Black Box Hacking Lab Screen\&quot;\u003e \u003ca href\u003d\&quot;./Presentation1Black%20Box%20system%20testing.pptx\&quot; class\u003d\&quot;btn\&quot;\u003e📂 Download Presentation\u003c/a\u003e \u003c/div\u003e \u003c!-- Project 2 --\u003e \u003cdiv class\u003d\&quot;project-card\&quot;\u003e \u003ch3\u003eProject 2: Enterprise Hybrid Lab \u0026 Splunk SIEM Engineering\u003c/h3\u003e \u003cp\u003eDesigned a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.\u003c/p\u003e \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e \u003cul\u003e \u003cli\u003e\u003cstrong\u003eNetwork Isolation:\u003c/strong\u003e Programmed pfSense firewalls to contain lateral host movement.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eOffensive Auditing:\u003c/strong\u003e Ran custom vulnerability sequences against target systems and corporate web elements.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eDetection Engineering:\u003c/strong\u003e Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.\u003c/li\u003e \u003c/ul\u003e \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;network-topology.png\&quot; alt\u003d\&quot;EVE-NG Network Topology Map\&quot;\u003e \u003ca href\u003d\&quot;./defensive-blue-team/splunk/\&quot; class\u003d\&quot;btn\&quot;\u003e💻 View Splunk Configurations\u003c/a\u003e \u003c/div\u003e \u003c!-- Contact Section --\u003e \u003csection style\u003d\&quot;text-align: center; margin-top: 4rem;\&quot;\u003e \u003ch2\u003e📩 Connect With Me\u003c/h2\u003e \u003cp\u003eLooking for a dedicated Security Analyst? Let&#39;s talk!\u003c/p\u003e \u003cp\u003e\u003cstrong\u003eEmail:\u003c/strong\u003e kofiagyei79@gmail.com\u003c/p\u003e \u003ca href\u003d\&quot;https://github.com\&quot; class\u003d\&quot;btn\&quot;\u003eGitHub Profile\u003c/a\u003e \u003c/section\u003e \u003c/div\u003e \u003cfooter\u003e \u0026copy; 2026 Kofi Agyei Portfolio. Built with HTML5 \u0026 CSS3. \u003c/footer\u003e\u003c/body\u003e\u003c/html\u003e&quot;,null,null,null,&quot;12:27 PM&quot;,nu