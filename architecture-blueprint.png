</div><!--TgQPHdMnlGHc_jf/YOIIaf;MnlGHc_jf/VWapad|||[{&quot;s&quot;:false,&quot;i&quot;:&quot;MnlGHc_jf/YOIIaf&quot;},{&quot;s&quot;:null,&quot;i&quot;:&quot;MnlGHc_jf/VWapad&quot;},156,{&quot;s&quot;:null,&quot;i&quot;:&quot;MnlGHc_jf/C5DOxd&quot;},[&quot;AimExportActionToastLink&quot;,309275],&quot;\u0026MnlGHc_jf:bREfu&quot;,false]--></div><!--TgQPHd|MnlGHc_jf/YOIIaf;MnlGHc_jf/LL5gb;MnlGHc_jf/We76zc;MnlGHc_jf/VWapad;MnlGHc_jf/C5DOxd||[[null,0,null,0,null,0,[&quot;\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\&quot;en\&quot;\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\&quot;UTF-8\&quot;\u003e\n    \u003cmeta name\u003d\&quot;viewport\&quot; content\u003d\&quot;width\u003ddevice-width, initial-scale\u003d1.0\&quot;\u003e\n    \u003ctitle\u003eKofi Agyei | Cybersecurity Portfolio\u003c/title\u003e\n    \u003cstyle\u003e\n        :root {\n            --bg-color: #0d1117;\n            --text-color: #c9d1d9;\n            --accent-color: #58a6ff;\n            --card-bg: #161b22;\n            --border-color: #30363d;\n        }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \&quot;Segoe UI\&quot;, Helvetica, Arial, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n        }\n        header {\n            background-color: var(--card-bg);\n            border-bottom: 1px solid var(--border-color);\n            padding: 2rem 1rem;\n            text-align: center;\n        }\n        h1 { color: #fff; margin-bottom: 0.5rem; }\n        h2, h3 { color: var(--accent-color); }\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n        .skills-list {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            padding: 0;\n            list-style: none;\n        }\n        .skills-list li {\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            padding: 0.75rem;\n            border-radius: 6px;\n            text-align: center;\n        }\n        .project-card {\n            background-color: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 2rem;\n            margin-bottom: 2.5rem;\n        }\n        .project-image {\n            max-width: 100%;\n            height: auto;\n            border-radius: 6px;\n            border: 1px solid var(--border-color);\n            margin: 1.5rem 0;\n            display: block;\n        }\n        .btn {\n            display: inline-block;\n            background-color: #21262d;\n            color: var(--accent-color);\n            border: 1px solid var(--border-color);\n            padding: 0.5rem 1rem;\n            border-radius: 6px;\n            text-decoration: none;\n            font-weight: 600;\n            margin-right: 0.5rem;\n            margin-top: 0.5rem;\n        }\n        .btn:hover {\n            background-color: #30363d;\n            border-color: #8b949e;\n        }\n        footer {\n            text-align: center;\n            padding: 2rem;\n            border-top: 1px solid var(--border-color);\n            font-size: 0.9rem;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader\u003e\n        \u003ch1\u003eKofi Agyei\u003c/h1\u003e\n        \u003cp\u003eCybersecurity Analyst \u0026 Systems Security Engineer\u003c/p\u003e\n    \u003c/header\u003e\n\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n        \n        \u003c!-- Skills Section --\u003e\n        \u003csection\u003e\n            \u003ch2\u003e🛠️ Technical Security Skills \u0026 Tools\u003c/h2\u003e\n            \u003cul class\u003d\&quot;skills-list\&quot;\u003e\n                \u003cli\u003e🟢 Network Scanning: \u003cstrong\u003eNmap\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Exploitation: \u003cstrong\u003eMetasploit\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Traffic Analysis: \u003cstrong\u003eWireshark\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 SIEM \u0026 Analytics: \u003cstrong\u003eSplunk\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Boundary Routing: \u003cstrong\u003epfSense / VPN\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Testing: \u003cstrong\u003eBlack Box Testing\u003c/strong\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n        \u003c/section\u003e\n\n        \u003chr style\u003d\&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;\&quot;\u003e\n\n        \u003c!-- Projects Section --\u003e\n        \u003ch2\u003e🚀 Cyber Range Portfolio Projects\u003c/h2\u003e\n\n        \u003c!-- Project 1 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 1: Black Box Hacking Simulation (Capstone)\u003c/h3\u003e\n            \u003cp\u003eSimulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eReconnaissance \u0026 Scanning:\u003c/strong\u003e Used Nmap for passive asset mapping and service fingerprinting.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003ePacket Analysis:\u003c/strong\u003e Tracked communication layers using Wireshark to locate system vulnerabilities.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eExploitation Sequence:\u003c/strong\u003e Used Metasploit Framework vectors to achieve root authorization footprints.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;black-box-hacking.png\&quot; alt\u003d\&quot;Black Box Hacking Lab Screen\&quot;\u003e\n            \u003ca href\u003d\&quot;./Presentation1Black%20Box%20system%20testing.pptx\&quot; class\u003d\&quot;btn\&quot;\u003e📂 Download Presentation\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Project 2 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 2: Enterprise Hybrid Lab \u0026 Splunk SIEM Engineering\u003c/h3\u003e\n            \u003cp\u003eDesigned a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eNetwork Isolation:\u003c/strong\u003e Programmed pfSense firewalls to contain lateral host movement.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eOffensive Auditing:\u003c/strong\u003e Ran custom vulnerability sequences against target systems and corporate web elements.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eDetection Engineering:\u003c/strong\u003e Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;network-topology.png\&quot; alt\u003d\&quot;EVE-NG Network Topology Map\&quot;\u003e\n            \u003ca href\u003d\&quot;./defensive-blue-team/splunk/\&quot; class\u003d\&quot;btn\&quot;\u003e💻 View Splunk Configurations\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Contact Section --\u003e\n        \u003csection style\u003d\&quot;text-align: center; margin-top: 4rem;\&quot;\u003e\n            \u003ch2\u003e📩 Connect With Me\u003c/h2\u003e\n            \u003cp\u003eLooking for a dedicated Security Analyst? Let&#39;s talk!\u003c/p\u003e\n            \u003cp\u003e\u003cstrong\u003eEmail:\u003c/strong\u003e kofiagyei79@gmail.com\u003c/p\u003e\n            \u003ca href\u003d\&quot;https://github.com\&quot; class\u003d\&quot;btn\&quot;\u003eGitHub Profile\u003c/a\u003e\n        \u003c/section\u003e\n\n    \u003c/div\u003e\n\n    \u003cfooter\u003e\n        \u0026copy; 2026 Kofi Agyei Portfolio. Built with HTML5 \u0026 CSS3.\n    \u003c/footer\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\&quot;en\&quot;\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\&quot;UTF-8\&quot;\u003e\n    \u003cmeta name\u003d\&quot;viewport\&quot; content\u003d\&quot;width\u003ddevice-width, initial-scale\u003d1.0\&quot;\u003e\n    \u003ctitle\u003eKofi Agyei | Cybersecurity Portfolio\u003c/title\u003e\n    \u003cstyle\u003e\n        :root {\n            --bg-color: #0d1117;\n            --text-color: #c9d1d9;\n            --accent-color: #58a6ff;\n            --card-bg: #161b22;\n            --border-color: #30363d;\n        }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \&quot;Segoe UI\&quot;, Helvetica, Arial, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n        }\n        header {\n            background-color: var(--card-bg);\n            border-bottom: 1px solid var(--border-color);\n            padding: 2rem 1rem;\n            text-align: center;\n        }\n        h1 { color: #fff; margin-bottom: 0.5rem; }\n        h2, h3 { color: var(--accent-color); }\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n        .skills-list {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            padding: 0;\n            list-style: none;\n        }\n        .skills-list li {\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            padding: 0.75rem;\n            border-radius: 6px;\n            text-align: center;\n        }\n        .project-card {\n            background-color: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 2rem;\n            margin-bottom:&quot;],1,0,[&quot;\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\&quot;en\&quot;\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\&quot;UTF-8\&quot;\u003e\n    \u003cmeta name\u003d\&quot;viewport\&quot; content\u003d\&quot;width\u003ddevice-width, initial-scale\u003d1.0\&quot;\u003e\n    \u003ctitle\u003eKofi Agyei | Cybersecurity Portfolio\u003c/title\u003e\n    \u003cstyle\u003e\n        :root {\n            --bg-color: #0d1117;\n            --text-color: #c9d1d9;\n            --accent-color: #58a6ff;\n            --card-bg: #161b22;\n            --border-color: #30363d;\n        }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \&quot;Segoe UI\&quot;, Helvetica, Arial, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n        }\n        header {\n            background-color: var(--card-bg);\n            border-bottom: 1px solid var(--border-color);\n            padding: 2rem 1rem;\n            text-align: center;\n        }\n        h1 { color: #fff; margin-bottom: 0.5rem; }\n        h2, h3 { color: var(--accent-color); }\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n        .skills-list {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            padding: 0;\n            list-style: none;\n        }\n        .skills-list li {\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            padding: 0.75rem;\n            border-radius: 6px;\n            text-align: center;\n        }\n        .project-card {\n            background-color: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 2rem;\n            margin-bottom: 2.5rem;\n        }\n        .project-image {\n            max-width: 100%;\n            height: auto;\n            border-radius: 6px;\n            border: 1px solid var(--border-color);\n            margin: 1.5rem 0;\n            display: block;\n        }\n        .btn {\n            display: inline-block;\n            background-color: #21262d;\n            color: var(--accent-color);\n            border: 1px solid var(--border-color);\n            padding: 0.5rem 1rem;\n            border-radius: 6px;\n            text-decoration: none;\n            font-weight: 600;\n            margin-right: 0.5rem;\n            margin-top: 0.5rem;\n        }\n        .btn:hover {\n            background-color: #30363d;\n            border-color: #8b949e;\n        }\n        footer {\n            text-align: center;\n            padding: 2rem;\n            border-top: 1px solid var(--border-color);\n            font-size: 0.9rem;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader\u003e\n        \u003ch1\u003eKofi Agyei\u003c/h1\u003e\n        \u003cp\u003eCybersecurity Analyst \u0026 Systems Security Engineer\u003c/p\u003e\n    \u003c/header\u003e\n\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n        \n        \u003c!-- Skills Section --\u003e\n        \u003csection\u003e\n            \u003ch2\u003e🛠️ Technical Security Skills \u0026 Tools\u003c/h2\u003e\n            \u003cul class\u003d\&quot;skills-list\&quot;\u003e\n                \u003cli\u003e🟢 Network Scanning: \u003cstrong\u003eNmap\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Exploitation: \u003cstrong\u003eMetasploit\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Traffic Analysis: \u003cstrong\u003eWireshark\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 SIEM \u0026 Analytics: \u003cstrong\u003eSplunk\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Boundary Routing: \u003cstrong\u003epfSense / VPN\u003c/strong\u003e\u003c/li\u003e\n                \u003cli\u003e🟢 Testing: \u003cstrong\u003eBlack Box Testing\u003c/strong\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n        \u003c/section\u003e\n\n        \u003chr style\u003d\&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;\&quot;\u003e\n\n        \u003c!-- Projects Section --\u003e\n        \u003ch2\u003e🚀 Cyber Range Portfolio Projects\u003c/h2\u003e\n\n        \u003c!-- Project 1 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 1: Black Box Hacking Simulation (Capstone)\u003c/h3\u003e\n            \u003cp\u003eSimulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eReconnaissance \u0026 Scanning:\u003c/strong\u003e Used Nmap for passive asset mapping and service fingerprinting.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003ePacket Analysis:\u003c/strong\u003e Tracked communication layers using Wireshark to locate system vulnerabilities.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eExploitation Sequence:\u003c/strong\u003e Used Metasploit Framework vectors to achieve root authorization footprints.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;black-box-hacking.png\&quot; alt\u003d\&quot;Black Box Hacking Lab Screen\&quot;\u003e\n            \u003ca href\u003d\&quot;./Presentation1Black%20Box%20system%20testing.pptx\&quot; class\u003d\&quot;btn\&quot;\u003e📂 Download Presentation\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Project 2 --\u003e\n        \u003cdiv class\u003d\&quot;project-card\&quot;\u003e\n            \u003ch3\u003eProject 2: Enterprise Hybrid Lab \u0026 Splunk SIEM Engineering\u003c/h3\u003e\n            \u003cp\u003eDesigned a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.\u003c/p\u003e\n            \n            \u003ch4\u003eCore Phases Execution:\u003c/h4\u003e\n            \u003cul\u003e\n                \u003cli\u003e\u003cstrong\u003eNetwork Isolation:\u003c/strong\u003e Programmed pfSense firewalls to contain lateral host movement.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eOffensive Auditing:\u003c/strong\u003e Ran custom vulnerability sequences against target systems and corporate web elements.\u003c/li\u003e\n                \u003cli\u003e\u003cstrong\u003eDetection Engineering:\u003c/strong\u003e Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.\u003c/li\u003e\n            \u003c/ul\u003e\n            \n            \u003cimg class\u003d\&quot;project-image\&quot; src\u003d\&quot;network-topology.png\&quot; alt\u003d\&quot;EVE-NG Network Topology Map\&quot;\u003e\n            \u003ca href\u003d\&quot;./defensive-blue-team/splunk/\&quot; class\u003d\&quot;btn\&quot;\u003e💻 View Splunk Configurations\u003c/a\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Contact Section --\u003e\n        \u003csection style\u003d\&quot;text-align: center; margin-top: 4rem;\&quot;\u003e\n            \u003ch2\u003e📩 Connect With Me\u003c/h2\u003e\n            \u003cp\u003eLooking for a dedicated Security Analyst? Let&#39;s talk!\u003c/p\u003e\n            \u003cp\u003e\u003cstrong\u003eEmail:\u003c/strong\u003e kofiagyei79@gmail.com\u003c/p\u003e\n            \u003ca href\u003d\&quot;https://github.com\&quot; class\u003d\&quot;btn\&quot;\u003eGitHub Profile\u003c/a\u003e\n        \u003c/section\u003e\n\n    \u003c/div\u003e\n\n    \u003cfooter\u003e\n        \u0026copy; 2026 Kofi Agyei Portfolio. Built with HTML5 \u0026 CSS3.\n    \u003c/footer\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\&quot;en\&quot;\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\&quot;UTF-8\&quot;\u003e\n    \u003cmeta name\u003d\&quot;viewport\&quot; content\u003d\&quot;width\u003ddevice-width, initial-scale\u003d1.0\&quot;\u003e\n    \u003ctitle\u003eKofi Agyei | Cybersecurity Portfolio\u003c/title\u003e\n    \u003cstyle\u003e\n        :root {\n            --bg-color: #0d1117;\n            --text-color: #c9d1d9;\n            --accent-color: #58a6ff;\n            --card-bg: #161b22;\n            --border-color: #30363d;\n        }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \&quot;Segoe UI\&quot;, Helvetica, Arial, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n        }\n        header {\n            background-color: var(--card-bg);\n            border-bottom: 1px solid var(--border-color);\n            padding: 2rem 1rem;\n            text-align: center;\n        }\n        h1 { color: #fff; margin-bottom: 0.5rem; }\n        h2, h3 { color: var(--accent-color); }\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n        .skills-list {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            padding: 0;\n            list-style: none;\n        }\n        .skills-list li {\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            padding: 0.75rem;\n            border-radius: 6px;\n            text-align: center;\n        }\n        .project-card {\n            background-color: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 2rem;\n            margin-bottom:&quot;,&quot;1 tab&quot;]]]--></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><div data-complete="true" data-processed="true"></div><script data-complete="true" nonce="" id="" type="text/javascript" data-async-executed="true" data-processed="true">window.jsl.dh('i8AKXaoSqHaekiLMP7sXH