" jscontroller="nqTR2b#MCVA2" data-sfc-root="ep" data-wiz-uids="MnlGHc_ai,MnlGHc_aj,MnlGHc_ak" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4QkK0UeggIAggBCBcQCA" data-processed="true"><div jsuid="MnlGHc_am" data-sfc-cp="" jsaction="" jscontroller="cXTEid#e0nEwf" data-sfc-root="ep" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Qh9gSeggIAggBCBcQCQ" data-processed="true"><button jsuid="MnlGHc_ar" class="FTsWP RmjGdc IsqrXb thAwWe" id="" aria-label="Edit &lt;!DOCTYPE html&gt;&lt;html lang=&quot;en&quot;&gt;&lt;head&gt; &lt;meta charset=&quot;UTF-8&quot;&gt; &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2.5rem; } .project-image { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--border-color); margin: 1.5rem 0; display: block; } .btn { display: inline-block; background-color: #21262d; color: var(--accent-color); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-right: 0.5rem; margin-top: 0.5rem; } .btn:hover { background-color: #30363d; border-color: #8b949e; } footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; } &lt;/style&gt;&lt;/head&gt;&lt;body&gt; &lt;header&gt; &lt;h1&gt;Kofi Agyei&lt;/h1&gt; &lt;p&gt;Cybersecurity Analyst &amp; Systems Security Engineer&lt;/p&gt; &lt;/header&gt; &lt;div class=&quot;container&quot;&gt; &lt;!-- Skills Section --&gt; &lt;section&gt; &lt;h2&gt;🛠️ Technical Security Skills &amp; Tools&lt;/h2&gt; &lt;ul class=&quot;skills-list&quot;&gt; &lt;li&gt;🟢 Network Scanning: &lt;strong&gt;Nmap&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Exploitation: &lt;strong&gt;Metasploit&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Traffic Analysis: &lt;strong&gt;Wireshark&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 SIEM &amp; Analytics: &lt;strong&gt;Splunk&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Boundary Routing: &lt;strong&gt;pfSense / VPN&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Testing: &lt;strong&gt;Black Box Testing&lt;/strong&gt;&lt;/li&gt; &lt;/ul&gt; &lt;/section&gt; &lt;hr style=&quot;border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;&quot;&gt; &lt;!-- Projects Section --&gt; &lt;h2&gt;🚀 Cyber Range Portfolio Projects&lt;/h2&gt; &lt;!-- Project 1 --&gt; &lt;div class=&quot;project-card&quot;&gt; &lt;h3&gt;Project 1: Black Box Hacking Simulation (Capstone)&lt;/h3&gt; &lt;p&gt;Simulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Reconnaissance &amp; Scanning:&lt;/strong&gt; Used Nmap for passive asset mapping and service fingerprinting.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Packet Analysis:&lt;/strong&gt; Tracked communication layers using Wireshark to locate system vulnerabilities.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Exploitation Sequence:&lt;/strong&gt; Used Metasploit Framework vectors to achieve root authorization footprints.&lt;/li&gt; &lt;/ul&gt; &lt;img class=&quot;project-image&quot; src=&quot;black-box-hacking.png&quot; alt=&quot;Black Box Hacking Lab Screen&quot;&gt; &lt;a href=&quot;./Presentation1Black%20Box%20system%20testing.pptx&quot; class=&quot;btn&quot;&gt;📂 Download Presentation&lt;/a&gt; &lt;/div&gt; &lt;!-- Project 2 --&gt; &lt;div class=&quot;project-card&quot;&gt; &lt;h3&gt;Project 2: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/h3&gt; &lt;p&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Network Isolation:&lt;/strong&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Offensive Auditing:&lt;/strong&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Detection Engineering:&lt;/strong&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/li&gt; &lt;/ul&gt; &lt;img class=&quot;project-image&quot; src=&quot;network-topology.png&quot; alt=&quot;EVE-NG Network Topology Map&quot;&gt; &lt;a href=&quot;./defensive-blue-team/splunk/&quot; class=&quot;btn&quot;&gt;💻 View Splunk Configurations&lt;/a&gt; &lt;/div&gt; &lt;!-- Contact Section --&gt; &lt;section style=&quot;text-align: center; margin-top: 4rem;&quot;&gt; &lt;h2&gt;📩 Connect With Me&lt;/h2&gt; &lt;p&gt;Looking for a dedicated Security Analyst? Let&#39;s talk!&lt;/p&gt; &lt;p&gt;&lt;strong&gt;Email:&lt;/strong&gt; kofiagyei79@gmail.com&lt;/p&gt; &lt;a href=&quot;https://github.com&quot; class=&quot;btn&quot;&gt;GitHub Profile&lt;/a&gt; &lt;/section&gt; &lt;/div&gt; &lt;footer&gt; &amp;copy; 2026 Kofi Agyei Portfolio. Built with HTML5 &amp; CSS3. &lt;/footer&gt;&lt;/body&gt;&lt;/html&gt;&lt;!DOCTYPE html&gt;&lt;html lang=&quot;en&quot;&gt;&lt;head&gt; &lt;meta charset=&quot;UTF-8&quot;&gt; &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom:" data-tooltip-classes="undefined" data-is-tooltip-wrapper="undefined" data-tooltip-id="undefined" aria-describedby="" data-sfc-cp="" jsaction="pointerdown:&amp;MnlGHc_ar|FEiYhc;pointerup:&amp;MnlGHc_ar|mF5Elf;pointerenter:&amp;MnlGHc_ar|EX0mI;pointerleave:&amp;MnlGHc_ar|vpvbp;pointercancel:&amp;MnlGHc_ar|xyn4sd;contextmenu:&amp;MnlGHc_ar|i2ZJ6;click:&amp;MnlGHc_ar|h5M