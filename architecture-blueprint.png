        </span><span class="ClTQqc" data-processed="true">&lt;!-- Project 2 --&gt;</span><span class="undefined" data-processed="true">
        &lt;</span><span class="mexSqb" data-processed="true">div</span><span class="undefined" data-processed="true"> class=</span><span class="CS0cqb" data-processed="true">"project-card"</span><span class="undefined" data-processed="true">&gt;
