Dcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="ep" jsuid="GtEtce_1p" data-complete="true">architecture-blueprint.png<!--TgQPHd|||[]--></code><!--TgQPHd|||[]--></strong> (make sure to select "All Files" when saving so it replaces the text extension).<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="GtEtce_1q" data-hveid="CAAIEBAD" data-complete="true" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="GtEtce_1r" data-complete="true">Open your GitHub repository dashboard: <span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="GtEtce_1s" data-complete="true">github.com<!--TgQPHd|||[]--></span>.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="GtEtce_1t" data-hveid="CAAIEBAE" data-complete="true" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="GtEtce_1u" data-complete="true">Click the <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="GtEtce_1v" data-complete="true">Add file<!--TgQPHd|||[]--></strong> dropdown, select <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="GtEtce_1w" data-complete="true">Upload files<!--TgQPHd|||[]--></strong>, and upload your newly created <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="ep" jsuid="GtEtce_1x" data-complete="true" data-sae="" style="">architecture-blueprint.png<!--TgQPHd|||[]--></code> file into your repository root directory.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="GtEtce_1y" data-hveid="CAAIEBAF" data-complete="true" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="GtEtce_1z" data-complete="true">Save by clicking the green <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="GtEtce_20" data-complete="true">Commit changes<!--TgQPHd|||[]--></strong> button.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></li><!--TgQPHd|||[]--></ol><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="ep" jsuid="GtEtce_21" data-hveid="CAAIERAA" data-complete="true" data-processed="true">Once uploaded, your portfolio page will immediately display this specialized architectural map alongside your EVE-NG simulation map. Let me know when you have uploaded the file so we can begin constructing your core Splunk detection analytics pipelines!<!--TgQPHd|||[]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;GtEtce_22|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="ep" jsuid="GtEtce_22" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div style="display: none;" jsuid="GtEtce_23" jsaction="rcuQ6b:&amp;GtEtce_23|npT2md" jscontroller="KEp6jb#HjxGxd" data-sfc-root="ep" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[[null,null,1,[&quot;cd0Gwf&quot;,&quot;[\&quot;rgiXatvOB9Hf5NoP8evf0Q8\&quot;]&quot;]]]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;GtEtce_24|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="ep" jsuid="GtEtce_24" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div jsuid="GtEtce_25" data-xid="Gd7Hsc" data-sfc-cp="" jsaction="aimRenderComplete:&amp;GtEtce_25|ZUljYd;rcuQ6b:&amp;GtEtce_25|npT2md" jscontroller="a5f0he#UaTW5b" data-sfc-root="ep" data-wiz-uids="GtEtce_26" data-c