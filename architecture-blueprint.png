--></button></div></div></div></div><div jsuid="MnlGHc_13k" style="display: none" class="Eonz0"><div class="mVQBZe">Thanks for letting us know</div></div><div jsuid="MnlGHc_13n" style="display: none" class="XpWxo"><div class="VT1SYd"><div class="QRnEfb">Google may use account and system data to understand your feedback and improve our services, subject to our <a href="https://policies.google.com/privacy" target="_blank" class="c0nryc"><span class="sds-typography-utility__colorOnSurfaceLink" style="">Privacy Policy</span></a> and <a href="https://policies.google.com/terms" target="_blank" class="c0nryc"><span class="sds-typography-utility__colorOnSurfaceLink">Terms of Service</span></a>. For legal issues, <a href="https://support.google.com/legal/answer/3110420" target="_blank" class="c0nryc"><span class="sds-typography-utility__colorOnSurfaceLink">make a legal removal request</span></a>.</div></div></div>\x3c!--TgQPHd|||[114,{&quot;u&quot;:0},false,false]--></div>');</script><div class="CKgc1d" data-scope-id="turn" jsname="CS7uPe" jsmodel="p9hQFe CPTaDd LUQCCe wuVnCd KgpZcc pRMv2d" jsaction="" jscontroller="uUCgYd#gXWog" data-sfc-root="ep" jsuid="MnlGHc_3" data-processed="true" style="--rhs-column-margin-top: -170px;"><div jsuid="MnlGHc_42" style="display: contents" jsaction="rcuQ6b:&amp;MnlGHc_42|npT2md" jscontroller="TB3Kme#Vp2Xub" data-sfc-root="ep" data-processed="true" data-sfc-inited="2"><!--qkimaf MnlGHc_42/HugV6--><div jsuid="MnlGHc_44" class="ilZyRc R7mRQb" jsaction="rcuQ6b:&amp;MnlGHc_44|npT2md" jscontroller="Qv2YAd#WGLFCb" data-sfc-root="ep" data-wiz-uids="MnlGHc_4c,MnlGHc_4d,MnlGHc_4f,MnlGHc_4g,MnlGHc_4h,MnlGHc_4i,MnlGHc_4j,MnlGHc_4k,MnlGHc_4l" data-processed="true" data-sfc-inited="2"><h2 class="iMqumd" data-processed="true">You sent: 1 tab and said: &lt;!DOCTYPE html&gt;&lt;html lang="en"&gt;&lt;head&gt; &lt;meta charset="UTF-8"&gt; &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2.5rem; } .project-image { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--border-color); margin: 1.5rem 0; display: block; } .btn { display: inline-block; background-color: #21262d; color: var(--accent-color); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-right: 0.5rem; margin-top: 0.5rem; } .btn:hover { background-color: #30363d; border-color: #8b949e; } footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; } &lt;/style&gt;&lt;/head&gt;&lt;body&gt; &lt;header&gt; &lt;h1&gt;Kofi Agyei&lt;/h1&gt; &lt;p&gt;Cybersecurity Analyst &amp; Systems Security Engineer&lt;/p&gt; &lt;/header&gt; &lt;div class="container"&gt; &lt;!-- Skills Section --&gt; &lt;section&gt; &lt;h2&gt;🛠️ Technical Security Skills &amp; Tools&lt;/h2&gt; &lt;ul class="skills-list"&gt; &lt;li&gt;🟢 Network Scanning: &lt;strong&gt;Nmap&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Exploitation: &lt;strong&gt;Metasploit&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Traffic Analysis: &lt;strong&gt;Wireshark&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 SIEM &amp; Analytics: &lt;strong&gt;Splunk&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Boundary Routing: &lt;strong&gt;pfSense / VPN&lt;/strong&gt;&lt;/li&gt; &lt;li&gt;🟢 Testing: &lt;strong&gt;Black Box Testing&lt;/strong&gt;&lt;/li&gt; &lt;/ul&gt; &lt;/section&gt; &lt;hr style="border: 0; border-top: 1px solid var(--border-color); margin: 3rem 0;"&gt; &lt;!-- Projects Section --&gt; &lt;h2&gt;🚀 Cyber Range Portfolio Projects&lt;/h2&gt; &lt;!-- Project 1 --&gt; &lt;div class="project-card"&gt; &lt;h3&gt;Project 1: Black Box Hacking Simulation (Capstone)&lt;/h3&gt; &lt;p&gt;Simulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Reconnaissance &amp; Scanning:&lt;/strong&gt; Used Nmap for passive asset mapping and service fingerprinting.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Packet Analysis:&lt;/strong&gt; Tracked communication layers using Wireshark to locate system vulnerabilities.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Exploitation Sequence:&lt;/strong&gt; Used Metasploit Framework vectors to achieve root authorization footprints.&lt;/li&gt; &lt;/ul&gt; &lt;img class="project-image" src="black-box-hacking.png" alt="Black Box Hacking Lab Screen"&gt; &lt;a href="./Presentation1Black%20Box%20system%20testing.pptx" class="btn"&gt;📂 Download Presentation&lt;/a&gt; &lt;/div&gt; &lt;!-- Project 2 --&gt; &lt;div class="project-card"&gt; &lt;h3&gt;Project 2: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/h3&gt; &lt;p&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/p&gt; &lt;h4&gt;Core Phases Execution:&lt;/h4&gt; &lt;ul&gt; &lt;li&gt;&lt;strong&gt;Network Isolation:&lt;/strong&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Offensive Auditing:&lt;/strong&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/li&gt; &lt;li&gt;&lt;strong&gt;Detection Engineering:&lt;/strong&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/li&gt; &lt;/ul&gt; &lt;img class="project-image" src="network-topology.png" alt="EVE-NG Network Topology Map"&gt; &lt;a href="./defensive-blue-team/splunk/" class="btn"&gt;💻 View Splunk Configurations&lt;/a&gt; &lt;/div&gt; &lt;!-- Contact Section --&gt; &lt;section style="text-align: center; margin-top: 4rem;"&gt; &lt;h2&gt;📩 Connect With Me&lt;/h2&gt; &lt;p&gt;Looking for a dedicated Security Analyst? Let's talk!&lt;/p&gt; &lt;p&gt;&lt;strong&gt;Email:&lt;/strong&gt; kofiagyei79@gmail.com&lt;/p&gt; &lt;a href="https://github.com" class="btn"&gt;GitHub Profile&lt;/a&gt; &lt;/section&gt; &lt;/div&gt; &lt;footer&gt; &amp;copy; 2026 Kofi Agyei Portfolio. Built with HTML5 &amp; CSS3. &lt;/footer&gt;&lt;/body&gt;&lt;/html&gt;&lt;!DOCTYPE html&gt;&lt;html lang="en"&gt;&lt;head&gt; &lt;meta charset="UTF-8"&gt; &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt; &lt;title&gt;Kofi Agyei | Cybersecurity Portfolio&lt;/title&gt; &lt;style&gt; :root { --bg-color: #0d1117; --text-color: #c9d1d9; --accent-color: #58a6ff; --card-bg: #161b22; --border-color: #30363d; } body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; margin: 0; padding: 0; } header { background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 2rem 1rem; text-align: center; } h1 { color: #fff; margin-bottom: 0.5rem; } h2, h3 { color: var(--accent-color); } .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; } .skills-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0; list-style: none; } .skills-list li { background: var(--card-bg); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 6px; text-align: center; } .project-card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom:</h2><div jsuid="MnlGHc_4c" aria-hidden="false" style="" data-animation-skip="" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4Q_sYPeggIAggBCBcQAA" data-processed="true"><div jsuid="MnlGHc_4l" class="xEFZqe" jsaction="mouseenter:&amp;MnlGHc_44|ZUljYd;focusin:&amp;MnlGHc_44|aXD3Gb;focusout:&amp;MnlGHc_44|Mrjwi" data-processed="true"><!--qkimaf MnlGHc_44/WyzG9e--><div class="SK38Xc" jsaction="rcuQ6b:&amp;MnlGHc_56|npT2md" jscontroller="Zdw5w#ZIKyQ" data-sfc-root="c" jsuid="MnlGHc_56" data-wiz-uids="MnlGHc_58" data-processed="true" data-sfc-inited="2"><div class="qeawje" jsaction="action:&amp;MnlGHc_56|ZUljYd" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4QhvMSeggIAggBCBcQAQ" data-processed="true"><div jsuid="MnlGHc_5e" class="YHsVn" data-sfc-cp="" jsaction="mouseenter:&amp;MnlGHc_5e|ZUljYd;mouseleave:&amp;MnlGHc_5e|aXD3Gb;focusin:&amp;MnlGHc_5e|Mrjwi;focusout:&amp;MnlGHc_5e|CXhG2e;" jscontroller="nqTR2b#MCVA2" data-sfc-root="ep" data-wiz-uids="MnlGHc_5m,MnlGHc_5n,MnlGHc_5o" data-ved="2ahUKEwiE4ueE7M2WAxUnEmIAHe7iEZ4QkK0UeggIAggBCBcQAg" data-processed="true"><div jsuid="MnlGHc_5t" class="YHsVn" data-sfc-cp="" jsaction="mouseenter:&amp;MnlGHc_5t|ZUljYd;mouseleave:&amp;MnlGHc_5t|aXD3Gb;focusin:&amp;MnlGHc_5t|Mrjwi;focusout:&amp;MnlGHc_5t|CXhG2e;" jscontroller="nqTR2b#MCVA2" data-sfc-root="ep" data-wiz