  border-radius: &quot;,0],[&quot;8&quot;,6],[&quot;px;\n            padding: &quot;,0],[&quot;2&quot;,6],[&quot;rem;\n            margin-bottom: &quot;,0],[&quot;2.5&quot;,6],[&quot;rem;\n        }\n        .project-image {\n            max-width: &quot;,0],[&quot;100&quot;,6],[&quot;%;\n            height: auto;\n            border-radius: &quot;,0],[&quot;6&quot;,6],[&quot;px;\n            border: &quot;,0],[&quot;1&quot;,6],[&quot;px solid var(--border-color);\n            margin: &quot;,0],[&quot;1.5&quot;,6],[&quot;rem &quot;,0],[&quot;0&quot;,6],[&quot;;\n            display: block;\n        }\n        .btn {\n            display: inline-block;\n            background-color: #&quot;,0],[&quot;21262&quot;,6],[&quot;d;\n            color: var(--accent-color);\n            border: &quot;,0],[&quot;1&quot;,6],[&quot;px solid var(--border-color);\n            padding: &quot;,0],[&quot;0.5&quot;,6],[&quot;rem &quot;,0],[&quot;1&quot;,6],[&quot;rem;\n            border-radius: &quot;,0],[&quot;6&quot;,6],[&quot;px;\n            text-decoration: none;\n            font-weight: &quot;,0],[&quot;600&quot;,6],[&quot;;\n            margin-right: &quot;,0],[&quot;0.5&quot;,6],[&quot;rem;\n            margin-top: &quot;,0],[&quot;0.5&quot;,6],[&quot;rem;\n        }\n        .btn:hover {\n            background-color: #&quot;,0],[&quot;30363&quot;,6],[&quot;d;\n            border-color: #&quot;,0],[&quot;8&quot;,6],[&quot;b&quot;,0],[&quot;949&quot;,6],[&quot;e;\n        }\n        footer {\n            text-align: center;\n            padding: &quot;,0],[&quot;2&quot;,6],[&quot;rem;\n            border-top: &quot;,0],[&quot;1&quot;,6],[&quot;px solid var(--border-color);\n            font-size: &quot;,0],[&quot;0.9&quot;,6],[&quot;rem;\n        }\n    \u003c/&quot;,0],[&quot;style&quot;,3],[&quot;\u003e\n\u003c/&quot;,0],[&quot;head&quot;,3],[&quot;\u003e\n\u003c&quot;,0],[&quot;body&quot;,3],[&quot;\u003e\n\n    \u003c&quot;,0],[&quot;header&quot;,3],[&quot;\u003e\n      