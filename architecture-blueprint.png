                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;🟢 Exploitation: &lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Metasploit&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt;&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
