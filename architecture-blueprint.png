asset (&quot;,0],[&quot;`192.168.60.50`&quot;,27],[&quot;).\n\n&quot;,0],[&quot;#### 3. Defensive Security Analytics \u0026 Detection Engineering (Blue Team)\n&quot;,3],[&quot;* **Log Ingestion Pipeline:** Configured &quot;,0],[&quot;`Splunk Universal Forwarders`&quot;,27],[&quot; on endpoints to harvest Linux authentication records (&quot;,0],[&quot;`linux_secure`&quot;,27],[&quot;), web daemon streams (&quot;,0],[&quot;`access_combined`&quot;,27],[&quot;), and host shell histories (&quot;,0],[&quot;`bash_history`&quot;,27],[&quot;).\n&quot;,0],[&quot;* &quot;,3],[&quot;**Threat Detection Architecture:** Developed custom Splunk Processing Language (SPL) rules to trigger high-fidelity alerts for network port scanning baselines, active SSH brute-force handshakes, and SQL injection strings.\n\n&quot;,0],[&quot;### 📂 Project 2 Assets\n&quot;,3],[&quot;* 💻 **Source Code/Scripts:** &quot;,0],[&quot;[View Splunk Configurations](./index.html)&quot;,4],[&quot;\n\n&quot;,0],[&quot;---\n&quot;,3],[&quot;\n&quot;,0],[&quot;## 📩 Contact \u0026 Connect\n&quot;,3],[&quot;\n&quot;,0],[&quot;* &quot;,3],[&quot;**Email:** kofiagyei79@gmail.com\n* **GitHub:** &quot;,0],[&quot;[kofiagyei79](https://github.com)&quot;,4],[&quot;\n\n© 2026 Kofi Agyei\n&quot;,0]]]]--></div><ol start="6" class="T9WCjf qkgVBf" data-sfc-cp="" jsaction="" jscontroller="PnN4Le#N1SbDe" data-sfc-root="ep" jsuid="NZP8vc_3n" data-complete="true" data-processed="true"><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="NZP8vc_3o" data-hveid="CAAIEhAB" data-complete="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="NZP8vc_3p" data-complete="true">Click the green <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="NZP8vc_3q" data-complete="true">Commit changes...<!--TgQPHd|||[]--></strong> button at the top right.<!--TgQPHd|||[]--></s