            &lt;</span><span class="mexSqb">h3</span><span class="undefined">&gt;Project </span><span class="tnfcCf">1</span><span class="undefined">: Black Box Hacking Simulation (Capstone)&lt;/</span><span class="mexSqb">h3</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">p</span><span class="undefined">&gt;Simulated a real-world defensive audit on a blind target environment. Researched hidden attack surfaces, ran stealth service tracking controls, exploited security gaps safely, and structured executive documentation briefs.&lt;/</span><span class="mexSqb">p</span><span class="undefined">&gt;
            
            &lt;</span><span class="mexSqb">h4</span><span class="undefined">&gt;Core Phases Execution:&lt;/</span><span class="mexSqb">h4</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">ul</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Reconnaissance &amp; Scanning:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Used Nmap for passive asset mapping and service fingerprinting.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Packet Analysis:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Tracked communication layers using Wireshark to locate system vulnerabilities.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Exploitation Sequence:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Used Metasploit Framework vectors to achieve root authorization footprints.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
            &lt;/</span><span class="mexSqb">ul</span><span class="undefined">&gt;
            
            &lt;</span><span class="mexSqb">img</span><span class="undefined"> class=</span><span class="CS0cqb">"project-image"</span><span class="undefined"> src=</span><span class="CS0cqb">"image/black-box-hacking.png"</span><span class="undefined"> alt=</span><span class="CS0cqb">"Black Box Hacking Lab Screen"</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">a</span><span class="undefined"> href=</span><span class="CS0cqb">"./Presentation1Black%20Box%20system%20testing.pptx"</span><span class="undefined"> class=</span><span class="CS0cqb">"btn"</span><span class="undefined">&gt;📂 Download Presentation&lt;/</span><span class="mexSqb">a</span><span class="undefined">&gt;
        &lt;/</span><span class="mexSqb">div</span><span class="undefined">&gt;

        </span><span class="ClTQqc">&lt;!-- Project 2 --&gt;</span><span class="undefined">
        &lt;</span><span class="mexSqb">div</span><span class="undefined"> class=</span><span class="CS0cqb">"project-card"</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">h3</span><span class="undefined">&gt;Project </span><span class="tnfcCf">2</span><span class="undefined">: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/</span><span class="mexSqb">h3</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">p</span><span class="undefined">&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/</span><span class="mexSqb">p</span><span class="undefined">&gt;
            
            &lt;</span><span class="mexSqb">h4</span><span class="undefined">&gt;Core Phases Execution:&lt;/</span><span class="mexSqb">h4</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">ul</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Network Isolation:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Offensive Auditing:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Detection Engineering:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
            &lt;/</span><span class="mexSqb">ul</span><span class="undefined">&gt;
            
            </span><span class="ClTQqc">&lt;!-- FIXED: Created a grid section to load both of your layout topologies side-by-side --&gt;</span><span class="undefined">
            &lt;</span><span class="mexSqb">div</span><span class="undefined"> class=</span><span class="CS0cqb">"project-image-container"</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">div</span><span class="undefined">&gt;
