        &lt;</span><span class="mexSqb">div</span><span class="undefined"> class=</span><span class="CS0cqb">"project-card"</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">h3</span><span class="undefined">&gt;Project </span><span class="tnfcCf">2</span><span class="undefined">: Enterprise Hybrid Lab &amp; Splunk SIEM Engineering&lt;/</span><span class="mexSqb">h3</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">p</span><span class="undefined">&gt;Designed a multi-site network lab within EVE-NG to evaluate zero-trust network layout boundaries. Simulated live Red Team penetration routing paths over an encrypted IPsec VPN tunnel while aggregating enterprise telemetry back to a central Splunk platform.&lt;/</span><span class="mexSqb">p</span><span class="undefined">&gt;
            
            &lt;</span><span class="mexSqb">h4</span><span class="undefined">&gt;Core Phases Execution:&lt;/</span><span class="mexSqb">h4</span><span class="undefined">&gt;
            &lt;</span><span class="mexSqb">ul</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Network Isolation:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Programmed pfSense firewalls to contain lateral host movement.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Offensive Auditing:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Ran custom vulnerability sequences against target systems and corporate web elements.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
                &lt;</span><span class="mexSqb">li</span><span class="undefined">&gt;&lt;</span><span class="mexSqb">strong</span><span class="undefined">&gt;Detection Engineering:&lt;/</span><span class="mexSqb">strong</span><span class="undefined">&gt; Engineered specialized Splunk Processing Language (SPL) rules to trigger immediate alerts on live attacks.&lt;/</span><span class="mexSqb">li</span><span class="undefined">&gt;
